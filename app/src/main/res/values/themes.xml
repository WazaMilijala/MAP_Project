<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.ValentinesGarage" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_red</item>
        <item name="colorPrimaryVariant">@color/primary_dark_red</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary_blue</item>
        <item name="colorSecondaryVariant">@color/secondary_dark_blue</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Custom style references (these point to styles.xml) -->
        <item name="bottomNavigationStyle">@style/Widget.ValentinesGarage.BottomNavigationView</item>
        <item name="materialCardViewStyle">@style/Widget.ValentinesGarage.CardView</item>
        <item name="actionBarStyle">@style/Widget.ValentinesGarage.ActionBar</item>
    </style>

</resources>