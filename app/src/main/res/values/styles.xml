<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Bottom Navigation Style -->
    <style name="Widget.ValentinesGarage.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="elevation">8dp</item>
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Card View Style -->
    <style name="Widget.ValentinesGarage.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Action Bar Style -->
    <style name="Widget.ValentinesGarage.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/primary_red</item>
        <item name="titleTextColor">@color/white</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Text Input Layout Style -->
    <style name="Widget.ValentinesGarage.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_red</item>
        <item name="hintTextColor">@color/primary_red</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.ValentinesGarage.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.ValentinesGarage.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_red</item>
        <item name="android:textColor">@color/primary_red</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Chip Styles -->
    <style name="Widget.ValentinesGarage.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/primary_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipMinHeight">32dp</item>
    </style>

</resources>